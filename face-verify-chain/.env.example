# Google Cloud Vision API key
# Requires a Google Cloud project with the Vision API enabled and a billing account attached.
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Ethereum Sepolia testnet RPC
# (Fallback/Priority URLs can be set with SEPOLIA_RPC_URL or RPC_URL)
RPC_URL=your_sepolia_rpc_url_here
SEPOLIA_RPC_URL=your_sepolia_rpc_url_here_optional

# Sepolia chain ID (used to build EIP-155 transactions, defaults to 11155111)
CHAIN_ID=11155111

# Private key of a TESTNET-ONLY wallet funded with free Sepolia test ETH.
# NEVER put a mainnet/real-funds private key here.
PRIVATE_KEY=your_testnet_wallet_private_key_here

# Filled in automatically after you run deploy_contract.py once, or manually provide an existing one.
CONTRACT_ADDRESS=your_deployed_contract_address_here
