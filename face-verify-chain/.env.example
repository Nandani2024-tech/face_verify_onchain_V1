# Google Cloud Vision API key — https://console.cloud.google.com/apis/credentials
# Requires a Google Cloud project with the Vision API enabled and a billing
# account attached (free tier: 1,000 requests/month, no charge; a card is
# required by Google as an anti-abuse measure even for free-tier usage).
# See README.md "Setup" section for step-by-step instructions.
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Ethereum Sepolia testnet RPC (public, free — no signup needed)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Sepolia chain ID (used to build EIP-155 transactions)
CHAIN_ID=11155111

# Private key of a TESTNET-ONLY wallet funded with free Sepolia test ETH.
# Faucets that do NOT require an existing mainnet ETH balance:
#   - https://faucet.quicknode.com/ethereum/sepolia
#   - https://cloud.google.com/application/web3/faucet/ethereum/sepolia
# (Alchemy/Infura faucets typically require you to already hold mainnet ETH.)
# NEVER put a mainnet/real-funds private key here.
PRIVATE_KEY=your_testnet_wallet_private_key_here

# Filled in automatically after you run deploy_contract.py once
CONTRACT_ADDRESS=
